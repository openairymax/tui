# =============================================================================
# Airymax SDK Rust — .gitignore
# =============================================================================

# Rust 构建产物
target/
**/target/
Cargo.lock

# Rust 分析
*.rs.bk

# IDE 配置
.vscode/
.idea/
.vs/
*.code-workspace

# 构建目录
build/
build-*/

# 环境与密钥
.env
.env.*
!.env.example
*.pem
*.key

# 操作系统
.DS_Store
Thumbs.db

# 编辑器临时文件
*.swp
*.swo
*~

# 日志与临时文件
*.log
*.tmp
*.bak

# ===== 通用兜底（2026-08 统一更新） =====
# 误放的大型运行时目录（JDK 等）与运行时产物
oracleJdk-*/
jdk-*/
*.log
*.sock
/run/
/logs/
