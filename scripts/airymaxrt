#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2025-2026 SPHARX Ltd.
# SPDX-License-Identifier: AGPL-3.0-or-later OR Apache-2.0
#
# airymaxrt — AirymaxRT 一键启动入口
#
# 在任意项目目录执行 `airymaxrt` 即可进入交互界面：
#   1. 定位组件（TUI / gateway_d / llm_d）
#   2. gateway 在线 → 直接进入 TUI；离线 → 自动拉起 llm_d + gateway_d
#   3. TUI 退出后清理本次拉起的守护进程（不影响已运行的外部 gateway）
#
# 安装（加入 PATH 即可）：
#   ln -s "$PWD/sdk/tui/scripts/airymaxrt" ~/bin/airymaxrt
#
# 日志（排查问题）：
#   - 终端：INFO/WARN/ERROR（彩色，带时间戳与级别）
#   - 文件：$AIRY_HOME/logs/airymaxrt.log（全量含 DEBUG，关键节点均有打点）
#   - 级别：AIRYRT_LOG_LEVEL=debug|info|warn|error（默认 info）
#
# 环境变量（均可覆盖默认值）：
#   AIRYRT_HOME       伞仓根（默认：脚本路径上溯自动推断）
#   AIRY_HOME         运行时根（默认 ~/.airymaxrt，等价 kubelet 节点运行时根）
#   AIRY_RUNTIME_DIR  运行时目录（默认 $AIRY_HOME/run，llm.sock 所在目录）
#   AIRY_GATEWAY_PORT gateway HTTP 端口（默认 8080）
#   AIRY_MODEL_CONFIG llm_d 模型配置（默认 $AIRYRT_HOME/ecosystem/manager/model/model.yaml）
#   AIRY_AGENT_FILE   Agent 定义文件（默认 agents/main.agent.yaml，相对当前目录）
#   AIRY_TUI_BIN / AIRY_GATEWAY_BIN / AIRY_LLM_BIN  组件路径覆盖
#   AIRYRT_LOG_LEVEL 日志级别（默认 info；debug 可看到完整排查信息）
#
# 组件缺失时：TUI 缺失报错退出；gateway_d/llm_d 缺失则以 OFFLINE 模式进入 TUI。

set -euo pipefail

# ── 定位伞仓根 ──────────────────────────────────────────────────────────────
# 解析符号链接得到脚本真实路径（支持 ~/bin/airymaxrt → 仓库 scripts/airymaxrt）
_SOURCE="${BASH_SOURCE[0]}"
while [ -L "$_SOURCE" ]; do
    _DIR="$(cd -P "$(dirname "$_SOURCE")" && pwd)"
    _SOURCE="$(readlink "$_SOURCE")"
    case "$_SOURCE" in
        /*) ;;
        *) _SOURCE="$_DIR/$_SOURCE" ;;
    esac
done
SCRIPT_DIR="$(cd -P "$(dirname "$_SOURCE")" && pwd)"
AIRYRT_HOME="${AIRYRT_HOME:-$(cd "$SCRIPT_DIR/../../.." && pwd)}"

# ── 配置 ─────────────────────────────────────────────────────────────────────
# AIRY_HOME 解析优先级：显式环境变量 > install.env 固化的安装位置
# （get-agentrt.sh 安装时写入，airymaxrt 应尊重已安装的节点运行时根）
# > 默认 ~/.airymaxrt。
if [ -z "${AIRY_HOME:-}" ]; then
    for _CAND in "$HOME/.local/share/airymaxrt/config/install.env" \
                 "$HOME/.airymaxrt/config/install.env"; do
        if [ -f "$_CAND" ] && _HOME="$(sed -n 's/^AIRY_HOME=//p' "$_CAND" 2>/dev/null | head -1)"; then
            if [ -n "$_HOME" ]; then
                AIRY_HOME="$_HOME"
                break
            fi
        fi
    done
fi
AIRY_HOME="${AIRY_HOME:-$HOME/.airymaxrt}"
RUNTIME_DIR="${AIRY_RUNTIME_DIR:-$AIRY_HOME/run}"
GATEWAY_PORT="${AIRY_GATEWAY_PORT:-8080}"
GATEWAY_URL="http://127.0.0.1:${GATEWAY_PORT}"
MODEL_CONFIG="${AIRY_MODEL_CONFIG:-$AIRYRT_HOME/ecosystem/manager/model/model.yaml}"
AGENT_FILE="${AIRY_AGENT_FILE:-agents/main.agent.yaml}"

# ── 日志系统：debug 全量写文件，info+ 打印终端 ─────────────────────────────
LOG_FILE="$AIRY_HOME/logs/airymaxrt.log"
AIRYRT_LOG_LEVEL="${AIRYRT_LOG_LEVEL:-info}"
mkdir -p "$AIRY_HOME/logs" "$RUNTIME_DIR"

_log_num() {
    case "$1" in
        debug) echo 0 ;;
        info)  echo 1 ;;
        warn)  echo 2 ;;
        error) echo 3 ;;
        *)     echo 1 ;;
    esac
}
LOG_LEVEL_NUM="$(_log_num "$AIRYRT_LOG_LEVEL")"

log() { # log <debug|info|warn|error> <消息...>
    local lvl="$1"
    shift
    [ "$(_log_num "$lvl")" -ge "$LOG_LEVEL_NUM" ] || return 0
    local line
    line="[$(date '+%Y-%m-%d %H:%M:%S')] [$(printf '%s' "$lvl" | tr '[:lower:]' '[:upper:]')] $*"
    # 终端日志统一走 stderr：避免被 $(cmd) 命令替换捕获（stdout 仅承载命令结果）
    case "$lvl" in
        info)  printf '\033[1;36m%s\033[0m\n' "$line" >&2 ;;
        warn)  printf '\033[1;33m%s\033[0m\n' "$line" >&2 ;;
        error) printf '\033[1;31m%s\033[0m\n' "$line" >&2 ;;
    esac
    printf '%s\n' "$line" >>"$LOG_FILE"
}

# ── 密钥加载：secrets.env（先到先得，set -a 自动 export 给子进程）───────────
# 候选位置：$AIRY_HOME/config → $AIRYRT_HOME/.airymaxrt/config → $PWD/.airymaxrt/config
_SECRET_SOURCES=(
    "$AIRY_HOME/config/secrets.env"
    "$AIRYRT_HOME/.airymaxrt/config/secrets.env"
    "$PWD/.airymaxrt/config/secrets.env"
)
for _SEC in "${_SECRET_SOURCES[@]}"; do
    if [ -f "$_SEC" ]; then
        log info "加载密钥文件: $_SEC"
        set -a
        # shellcheck disable=SC1090
        . "$_SEC"
        set +a
        break
    fi
done

log debug "==== airymaxrt 启动 ===="
log debug "配置: AIRYRT_HOME=$AIRYRT_HOME AIRY_HOME=$AIRY_HOME RUNTIME_DIR=$RUNTIME_DIR"
log debug "配置: GATEWAY_URL=$GATEWAY_URL MODEL_CONFIG=$MODEL_CONFIG AGENT_FILE=$AGENT_FILE"

# ── 组件定位 ─────────────────────────────────────────────────────────────────
# find_tool <env_name> <command_name> <候选路径...>
#   优先显式环境变量，其次伞仓内构建产物，最后 PATH 中的命令。
find_tool() {
    local env_name="$1" cmd_name="$2"
    shift 2
    if [ -n "${!env_name:-}" ]; then
        log debug "$env_name 环境变量覆盖: ${!env_name}"
        if [ -x "${!env_name}" ]; then
            echo "${!env_name}"
            return
        fi
        log warn "$env_name 指向的路径不可执行: ${!env_name}"
    fi
    local c
    for c in "$@"; do
        if [ -x "$c" ]; then
            log debug "找到 $cmd_name: $c"
            echo "$c"
            return
        fi
        log debug "候选不存在: $c"
    done
    local from_path
    if from_path="$(command -v "$cmd_name" 2>/dev/null)"; then
        log debug "PATH 中找到 $cmd_name: $from_path"
        echo "$from_path"
    else
        log warn "未找到 $cmd_name（PATH 与候选路径均无）"
    fi
}

TUI_BIN="$(find_tool AIRY_TUI_BIN agentrt-tui \
    "$AIRY_HOME/bin/agentrt-tui" \
    "$AIRYRT_HOME/sdk/tui/target/release/agentrt-tui" \
    "$AIRYRT_HOME/sdk/tui/target/debug/agentrt-tui")"

GATEWAY_BIN="$(find_tool AIRY_GATEWAY_BIN gateway_d \
    "$AIRY_HOME/bin/gateway_d" \
    "$AIRYRT_HOME/agentrt/build/bin/gateway_d" \
    "$AIRYRT_HOME/build/bin/gateway_d")"

LLM_BIN="$(find_tool AIRY_LLM_BIN llm_d \
    "$AIRY_HOME/bin/llm_d" \
    "$AIRYRT_HOME/agentrt/build/bin/llm_d" \
    "$AIRYRT_HOME/build/bin/llm_d")"

log debug "组件定位结果: TUI_BIN=${TUI_BIN:-（缺失）}"
log debug "组件定位结果: GATEWAY_BIN=${GATEWAY_BIN:-（缺失）}"
log debug "组件定位结果: LLM_BIN=${LLM_BIN:-（缺失）}"

# ── 等待辅助（每轮打点，便于排查就绪时序） ─────────────────────────────────
wait_for_health() { # <url> <秒数>
    local url="$1" tries="$2" i
    log debug "健康检查开始: $url（最多 ${tries}s）"
    for ((i = 0; i < tries; i++)); do
        if curl -fsS -m 1 "$url" >/dev/null 2>&1; then
            log debug "健康检查通过: $url（第 $((i + 1)) 次尝试）"
            return 0
        fi
        log debug "健康检查未就绪: $url（第 $((i + 1)) 次尝试）"
        sleep 1
    done
    log debug "健康检查超时: $url"
    return 1
}

wait_for_sock() { # <socket路径> <秒数>
    local path="$1" tries="$2" i
    log debug "socket 等待开始: $path（最多 ${tries}s）"
    for ((i = 0; i < tries; i++)); do
        if [ -S "$path" ]; then
            log debug "socket 已就绪: $path（第 $((i + 1)) 次尝试）"
            return 0
        fi
        log debug "socket 未就绪: $path（第 $((i + 1)) 次尝试）"
        sleep 1
    done
    log debug "socket 等待超时: $path"
    return 1
}

# ── 前置检查 ─────────────────────────────────────────────────────────────────
if [ -z "$TUI_BIN" ]; then
    log error "未找到 agentrt-tui，请先构建：cd \"$AIRYRT_HOME/sdk/tui\" && cargo build --release"
    exit 1
fi
log info "组件就绪: TUI=$(basename "$TUI_BIN")"

# ── 状态判断 1：gateway 已在线？直接进入 ───────────────────────────────────
if wait_for_health "$GATEWAY_URL/health" 1; then
    log info "gateway 在线（$GATEWAY_URL），直接进入交互界面"
    log debug "执行: \"$TUI_BIN\" --gateway-url \"$GATEWAY_URL\" --agent-file \"$AGENT_FILE\""
    exec "$TUI_BIN" --gateway-url "$GATEWAY_URL" --agent-file "$AGENT_FILE"
fi
log info "gateway 离线（$GATEWAY_URL），尝试拉起守护进程"

# ── 拉起守护进程（仅本次会话，退出后清理） ─────────────────────────────────
DAEMONS_STARTED=0
GATEWAY_PID=""
LLM_PID=""

cleanup() {
    if [ "$DAEMONS_STARTED" != "1" ]; then
        log debug "清理跳过：本次未拉起任何守护进程"
        return 0
    fi
    log debug "清理开始：停止本次拉起的守护进程"
    if [ -n "$GATEWAY_PID" ]; then
        log debug "kill gateway_d (PID=$GATEWAY_PID)"
        if kill "$GATEWAY_PID" 2>/dev/null; then
            log info "已停止 gateway_d（PID=$GATEWAY_PID）"
        else
            log warn "gateway_d（PID=$GATEWAY_PID）可能已退出，无需停止"
        fi
    fi
    if [ -n "$LLM_PID" ]; then
        log debug "kill llm_d (PID=$LLM_PID)"
        if kill "$LLM_PID" 2>/dev/null; then
            log info "已停止 llm_d（PID=$LLM_PID）"
        else
            log warn "llm_d（PID=$LLM_PID）可能已退出，无需停止"
        fi
    fi
    wait 2>/dev/null || true
    log debug "清理完成"
}
trap cleanup EXIT

if [ -z "$GATEWAY_BIN" ] || [ -z "$LLM_BIN" ]; then
    log warn "gateway_d/llm_d 未找到，将以 OFFLINE 模式进入（对话功能不可用）。"
    log warn "构建 daemons：cd \"$AIRYRT_HOME/agentrt\" && cmake -B build && cmake --build build -j"
else
    # ---- 拉起 llm_d：后台启动，等待 socket 就绪 ----
    if [ -f "$MODEL_CONFIG" ]; then
        log debug "llm_d 使用模型配置: $MODEL_CONFIG"
        log debug "执行: \"$LLM_BIN\" --manager \"$MODEL_CONFIG\" > \"$AIRY_HOME/logs/llm_d.out\" 2>&1 &"
        "$LLM_BIN" --manager "$MODEL_CONFIG" >"$AIRY_HOME/logs/llm_d.out" 2>&1 &
    else
        log warn "模型配置不存在（$MODEL_CONFIG），llm_d 使用默认配置"
        log debug "执行: \"$LLM_BIN\" > \"$AIRY_HOME/logs/llm_d.out\" 2>&1 &"
        "$LLM_BIN" >"$AIRY_HOME/logs/llm_d.out" 2>&1 &
    fi
    LLM_PID=$!
    DAEMONS_STARTED=1
    log info "llm_d 已拉起（PID=$LLM_PID），日志: $AIRY_HOME/logs/llm_d.out"

    if wait_for_sock "$RUNTIME_DIR/llm.sock" 8; then
        log info "llm_d 就绪（$RUNTIME_DIR/llm.sock）"
    else
        log warn "llm_d socket 未就绪（$RUNTIME_DIR/llm.sock），查看日志: $AIRY_HOME/logs/llm_d.out"
    fi

    # ---- 拉起 gateway_d：后台启动，等待健康检查通过 ----
    log debug "执行: \"$GATEWAY_BIN\" -h 127.0.0.1 -p \"$GATEWAY_PORT\" > \"$AIRY_HOME/logs/gateway_d.out\" 2>&1 &"
    "$GATEWAY_BIN" -h 127.0.0.1 -p "$GATEWAY_PORT" >"$AIRY_HOME/logs/gateway_d.out" 2>&1 &
    GATEWAY_PID=$!
    log info "gateway_d 已拉起（PID=$GATEWAY_PID），日志: $AIRY_HOME/logs/gateway_d.out"

    if wait_for_health "$GATEWAY_URL/health" 10; then
        log info "gateway 就绪（$GATEWAY_URL）"
    else
        log warn "gateway 启动超时，查看日志: $AIRY_HOME/logs/gateway_d.out"
    fi
fi

# ── 前台进入 TUI（退出后由 EXIT trap 清理本次拉起的 daemons）──────────────
log debug "执行: \"$TUI_BIN\" --gateway-url \"$GATEWAY_URL\" --agent-file \"$AGENT_FILE\""
log info "进入交互界面（Ctrl+C 退出）"
"$TUI_BIN" --gateway-url "$GATEWAY_URL" --agent-file "$AGENT_FILE"
rc=$?
log info "交互界面退出（exit=$rc）"
exit $rc
